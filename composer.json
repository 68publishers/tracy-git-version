{
	"name": "68publishers/tracy-git-version",
	"description": "Git version panel for Tracy.",
	"keywords": [
		"68publishers",
		"tracy",
		"git",
		"git version",
		"nette"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Tomáš Glawaty",
			"email": "tomasglawaty@icloud.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-json": "*",
		"tracy/tracy": "^2.10"
	},
	"require-dev": {
		"czproject/git-php": "^4.2",
		"friendsofphp/php-cs-fixer": "^3.89",
		"nette/application": "^3.1.15",
		"nette/bootstrap": "^3.1",
		"nette/di": "^3.1.3",
		"nette/tester": "^2.6",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-nette": "^2.0",
		"roave/security-advisories": "dev-latest",
		"symfony/console": "^5.4.47 || ^6.4 || ^7.0 || ^8.0"
	},
	"suggest": {
		"nette/di": "For an integration with the Nette Framework.",
		"symfony/console": "If you want to use a git repository cloning for production build purposes."
	},
	"conflict": {
		"nette/di": "<3.1.3",
		"nette/utils": "<3.2.10",
		"nette/schema": "<1.2.5",
		"symfony/console": "<5.4.47"
	},
	"autoload": {
		"psr-4": {
			"SixtyEightPublishers\\TracyGitVersion\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SixtyEightPublishers\\TracyGitVersion\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"bin": [
		"tracy-git-version"
	]
}
